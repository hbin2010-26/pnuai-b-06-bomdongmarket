# 이 파일을 .env로 복사한 뒤 placeholder를 로컬 비밀값으로 교체하세요.
# .env는 .gitignore에 등록되어 커밋되지 않습니다.

# Docker Compose 백엔드 설정
# Spring Boot를 직접 실행할 때는 DB_URL의 db:3306을 localhost:3307로 바꾸세요.

# 컨테이너 OS 시간대. JVM 기본 시간대는 코드에서 KST로 고정하므로 감사 시각은 이 값과 무관하게 안전하지만,
# 로그·shell date 등 OS 레벨을 db 서비스와 통일하려고 함께 둡니다.
TZ=Asia/Seoul
DB_URL=jdbc:mysql://db:3306/farmbroker?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=replace-with-local-db-password
JPA_DDL_AUTO=update
JPA_OPEN_IN_VIEW=false
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SERVER_CONTEXT_PATH=/api

# 쉼표로 구분한 프론트엔드 Origin. 운영에서는 Vercel 주소를 추가하세요.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 공간 사진 업로드 저장 경로
# Docker Compose는 이 경로에 named volume(farmbroker-uploads)을 마운트합니다.
# Spring Boot를 직접 실행할 때는 비워 두면 farmbroker/uploads에 저장됩니다.
FILE_UPLOAD_DIR=/var/farmbroker/uploads
FILE_MAX_FILE_SIZE=5MB
FILE_MAX_REQUEST_SIZE=55MB

# JWT 서명 키(최소 32바이트)
JWT_SECRET=replace-with-at-least-32-character-secret

# JWT 만료 시간(ms, 기본 1일)
JWT_EXPIRATION=86400000

# 인증 쿠키 속성 — Access Token을 담는 httpOnly 쿠키
# ⚠️ 운영(HTTPS)에서는 반드시 JWT_COOKIE_SECURE=true 로 둘 것.
#    false로 두면 평문 HTTP로도 쿠키가 실려나가 토큰 탈취 경로가 열립니다.
# cross-site 배포로 전환하면 JWT_COOKIE_SAMESITE=None + JWT_COOKIE_SECURE=true 가 필요합니다.
JWT_COOKIE_NAME=accessToken
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Gmail SMTP (회원가입 이메일 인증)
# 1) Google 계정에 2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 앱 비밀번호를 발급하세요.
# 2) MAIL_PASSWORD에는 계정 비밀번호가 아니라 16자리 앱 비밀번호를 공백 없이 넣습니다.
# MAIL_USERNAME을 비워 두면 메일을 보내지 않고 인증번호를 서버 콘솔에 출력합니다(로컬 개발용).
# ⚠️ 운영(Render)에서는 대시보드 Environment에 직접 넣어야 합니다 — CD는 배포만 트리거합니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=replace-with-gmail-app-password

# 인증번호 정책 — 유효시간(초), 재발송 쿨다운(초), 최대 시도 횟수, 인증 후 가입 유효시간(분)
EMAIL_VERIFICATION_TTL_SECONDS=300
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_VERIFIED_WINDOW_MINUTES=30

# Gemini API 설정
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 공공데이터포털 (한국농수산식품유통공사_일별 도·소매 가격정보)
KAMIS_SERVICE_KEY=replace-with-data-go-kr-service-key
# 배치 날짜와 수집 시각을 서버 기본 시간대와 무관하게 맞춥니다.
KAMIS_TIMEZONE=Asia/Seoul
# 외부 API 연결 및 읽기 정체 시간 제한(ms)
KAMIS_CONNECT_TIMEOUT_MS=3000
KAMIS_READ_TIMEOUT_MS=5000

# Kakao Developers에서 발급한 JavaScript 키. 플랫폼 > Web에 실행 도메인을 등록해야 동작합니다.
# 비워 두면 주소 검색은 그대로 동작하고 지도 미리보기만 안내 문구로 대체됩니다.
VITE_KAKAO_MAP_APP_KEY=
